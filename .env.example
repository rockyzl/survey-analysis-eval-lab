# Copy to .env (gitignored). No API keys: auth uses a short-lived token from the local Azure CLI login.
SURVEYLAB_AZURE_ENDPOINT=https://<your-resource>.openai.azure.com/
SURVEYLAB_AZURE_SUBSCRIPTION=<subscription-id>
# Optional second resource hosting gpt-5.2 (low capacity)
SURVEYLAB_AZURE_ENDPOINT_GPT52=https://<other-resource>.cognitiveservices.azure.com/
