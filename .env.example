# Export these in your shell (the code reads ONLY environment variables; no .env file is loaded).
# Default provider: the OpenAI API. The key is read from the environment; never commit it.
# export OPENAI_API_KEY=<your-key>
# export SURVEYLAB_LLM_ENABLED=1   # required for live calls; without it only cached responses are replayed
# export SURVEYLAB_SPEND_CAP_USD=8   # live calls stop at this list-price spend (default 8)

# Optional: only to replay the superseded Azure cache (SURVEYLAB_LLM_PROVIDER=azure)
# Azure auth uses a short-lived token from the local Azure CLI login, for the subscription named here (no API key).
# export SURVEYLAB_LLM_PROVIDER=azure
# export SURVEYLAB_AZURE_ENDPOINT=https://<your-resource>.openai.azure.com/
# export SURVEYLAB_AZURE_SUBSCRIPTION=<your-subscription-id>
