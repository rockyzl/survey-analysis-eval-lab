{
 "_about": "Hand-specified (expert) mapping from CDC BRFSS Prevalence & Trends (P&T) 2025 question/response labels to LLCP 2025 variables and codes. 'responses' maps each P&T response label to the variable codes that count as that response (the numerator). 'valid' lists the codes that form the denominator; every other code (7/9/77/99 don't know/refused, blank/missing, out-of-universe) is excluded from the denominator. Written from catalog/codebook.json value labels before running Gate 0.",
 "indicators": {
  "_RFHLTH": {"variable": "_RFHLTH", "topic": "Fair or poor self-rated health", "valid": [1, 2], "responses": {"Fair or Poor Health": [2], "Good or Better Health": [1]}, "synonyms": ["fair or poor health", "poor health", "self-rated health", "general health fair or poor"]},
  "GENHLTH": {"variable": "GENHLTH", "topic": "Self-rated general health (5 levels)", "valid": [1, 2, 3, 4, 5], "responses": {"Excellent": [1], "Very good": [2], "Good": [3], "Fair": [4], "Poor": [5]}, "synonyms": ["general health", "excellent health", "very good health"]},
  "_PHYS14D": {"variable": "_PHYS14D", "topic": "Days physical health not good (past 30)", "valid": [1, 2, 3], "responses": {"Zero days when physical health not good": [1], "1-13 days when physical health not good": [2], "14+ days when physical health not good": [3]}, "synonyms": ["frequent physical distress", "physical health not good 14 or more days"]},
  "_MENT14D": {"variable": "_MENT14D", "topic": "Days mental health not good (past 30)", "valid": [1, 2, 3], "responses": {"Zero days when mental health not good": [1], "1-13 days when mental health not good": [2], "14+ days when mental health not good": [3]}, "synonyms": ["frequent mental distress", "mental health not good 14 or more days"]},
  "_HLTHPL2": {"variable": "_HLTHPL2", "topic": "Any health insurance (all adults)", "valid": [1, 2], "responses": {"Have some form of health insurance": [1], "Do not have some form of health insurance": [2]}, "synonyms": ["health insurance", "uninsured", "health care coverage"]},
  "_HCVU654": {"variable": "_HCVU654", "topic": "Any health insurance, adults aged 18-64", "valid": [1, 2], "responses": {"Have some form of health insurance": [1], "Do not have some form of health insurance": [2]}, "universe": "adults aged 18-64 (out-of-universe coded 9)", "synonyms": ["uninsured working-age adults", "health coverage 18-64"]},
  "PERSDOC3": {"variable": "PERSDOC3", "topic": "Has a personal doctor or health care provider", "valid": [1, 2, 3], "responses": {"Yes, only one": [1], "More than one": [2], "No": [3]}, "synonyms": ["personal doctor", "usual health care provider"]},
  "MEDCOST1": {"variable": "MEDCOST1", "topic": "Could not see a doctor because of cost (past 12 months)", "valid": [1, 2], "responses": {"Yes": [1], "No": [2]}, "synonyms": ["cost barrier to care", "could not afford doctor"]},
