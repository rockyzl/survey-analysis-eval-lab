  "_CURECI3": {"variable": "_CURECI3", "topic": "Current e-cigarette user", "valid": [1, 2], "responses": {"Current E-cigarette user": [2], "Not currently using E-cigarettes": [1]}, "synonyms": ["current vaping", "current e-cigarette use"]},
