  "_RFHYPE6": {"variable": "_RFHYPE6", "topic": "Ever told high blood pressure", "valid": [1, 2], "responses": {"Yes": [2], "No": [1]}, "synonyms": ["hypertension", "high blood pressure"]},
  "_CHOLCH3": {"variable": "_CHOLCH3", "topic": "Cholesterol checked within past 5 years", "valid": [1, 2, 3], "responses": {"Checked in past 5 years": [1], "Not Checked in past 5 years": [2], "Never Checked": [3]}, "synonyms": ["cholesterol screening"]},
